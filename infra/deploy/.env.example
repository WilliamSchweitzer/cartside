# Copy to .deploy/demo.env, chmod 600. Generate independent hex secrets.
IMAGE_TAG=demo-001
POSTGRES_USER=cartside
POSTGRES_DB=cartside
POSTGRES_PASSWORD=replace_with_64_hex_characters
KEYCLOAK_DB_PASSWORD=replace_with_64_hex_characters
KEYCLOAK_ADMIN_USERNAME=demo-bootstrap-admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_64_hex_characters
CARTSIDE_OIDC_CLIENT_SECRET=replace_with_64_hex_characters
CARTSIDE_SESSION_SECRET=replace_with_64_hex_characters
CARTSIDE_AI_SERVICE_KEY=replace_with_64_hex_characters
# Public launch: explicitly set to 0.0.0.0 after firewall review. Local only by default.
EDGE_BIND=127.0.0.1
HTTPS_PORT=443
