# Compose consumes POSTGRES_* and the Keycloak/APISIX variables below.
# Host-run Go consumes DATABASE_URL and HTTP_ADDR.
# Host-run Vite needs no environment variables. Never expose these secrets via VITE_*.
# Local development only. Replace this password and match it in DATABASE_URL.
# Use URL-encoding for special characters in DATABASE_URL credentials.
POSTGRES_USER=cartside
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=cartside
DATABASE_URL=postgres://cartside:replace_with_local_password@127.0.0.1:5432/cartside?sslmode=disable
# Host-run Go must be reachable from APISIX; this binds all IPv4 interfaces.
# Restrict access with your host firewall. Direct-backend bypass is not prevented.
HTTP_ADDR=0.0.0.0:8080

# Local Keycloak only; generate separate secrets (see README). Do not use placeholders.
# Database and role are both fixed as keycloak, separate from POSTGRES_DB/POSTGRES_USER.
KEYCLOAK_DB_PASSWORD=replace_with_separate_random_hex
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_random_hex
CARTSIDE_OIDC_CLIENT_SECRET=replace_with_random_hex

# APISIX encrypted browser session; independent random 32-byte secret (README).
CARTSIDE_SESSION_SECRET=replace_with_separate_random_hex
